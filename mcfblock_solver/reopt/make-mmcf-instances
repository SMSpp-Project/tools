#!/usr/bin/env bash
#
# make-mmcf-instances [ out-dir ]
#
# Writes the Multicommodity Min-Cost Flow instances of mmcf-instances.txt in
# <out-dir> (default instances/): those built on a DIMACS instance as
# <family>-<log2n>-<seed>.pprn, in the PPRN format, with gen/bin/dmx2pprn
# [see gen/fetch-generators] and the parameters of Frangioni and Manca
# (2006), i.e., 10 commodities, mutual capacities 4 times the original ones
# and the deficits and the capacities of each commodity the original ones
# (the scaling factor is drawn in [ 1 , r ] with r = 1, which dmx2pprn
# writes as size 0), so that all the data but the costs are integer, the DIMACS instance being written by
# make-instances if it is not there; the PDS ones as pds/pds<t>.{nod,arc,
# mut,sup}, in the Mnetgen format, from the MMCF page of the Operations
# Research group of Pisa. An instance already there is not written again.

set -eu
here=$(cd "$(dirname "$0")" && pwd)
out=${1:-$here/instances}
bin=$here/gen/bin
[ -x "$bin/dmx2pprn" ] || { echo "make-mmcf-instances: run gen/fetch-generators first" >&2; exit 1; }
mkdir -p "$out"

# the DIMACS instances the MMCF ones are built on, and those alone
grep -v '^#' "$here/mmcf-instances.txt" | grep -v '^pds ' |
  "$here/make-instances" "$out" /dev/stdin

grep -v '^#' "$here/mmcf-instances.txt" | while read -r fam l s; do
  [ -n "$fam" ] || continue
  if [ "$fam" = pds ]; then
    [ -s "$out/pds/pds$l.arc" ] && continue
    mkdir -p "$out/pds"
    curl -sfL -m 600 https://commalab.di.unipi.it/files/Data/MMCF/Pds-m.tgz |
      tar xz -C "$out/pds" --strip-components=1
    continue
  fi
  f=$out/$fam-$l-$s.pprn
  [ -s "$f" ] && continue
  [ -s "$out/$fam-$l-$s.dmx" ] ||
    { echo "make-mmcf-instances: $fam $l $s is not in instances.txt" >&2; exit 1; }
  "$bin/dmx2pprn" "$out/$fam-$l-$s.dmx" "$f.tmp" 10 "$s" 4 0 > /dev/null
  mv "$f.tmp" "$f"
done
