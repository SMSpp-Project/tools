#!/usr/bin/env bash
#
# run-campaign < out-dir > [ name ... ]
#
# Runs every method of the study on every instance of instances.txt (or on
# those named) and appends one line per run to <out-dir>/runs.csv:
#
#   instance,method,status,lb,ub,time,iter,rss,rub,rtime,gap,rep,l0,l1
#
# the first eleven fields being those of ldld_bench (rub, rtime and gap are
# empty for a method with no primal recovery), rep the repetition, l0 and l1
# the load of the machine at the start and at the end of the run. The log of
# each run goes to <out-dir>/logs/<instance>.<method>.<rep>.log.
#
# Each run is a process of its own, one at a time, and starts only when the
# load is below $QUIET: the times of the paper are taken on an otherwise idle
# machine, and a run whose load was above $QUIET at its end is marked by its
# l1 and is to be repeated, not quoted. A run already in runs.csv as a measure
# is skipped, and one that is there with a load above the threshold is run
# again, so that launching the campaign again both resumes it and redoes what
# the load spoiled. With
# REPS=2 every run is repeated, which measures the noise (the same method
# against itself) before two methods are compared.
#
# Environment: BENCH (the ldld_bench to run, default build/ldld_bench),
# METHODS (default "0 1 2 3 4 5", the indices of the Solver in
# config/TSSBSCfg.txt), REPS (default 1), QUIET (default 8), TIMEOUT
# (seconds of wall time, default 5400, the methods themselves stopping at
# 3600), JOBS (threads of the primal recovery, default 1), BUSY (an
# extended regular expression on the command lines of the processes of the
# machine: while one of them runs, e.g., another campaign whose load the
# threshold would let through, no run is started; default none).
#
# A facility location (cfl_) or network design (mmcf_) instance runs the MILP, its relaxation and the
# MILP on one thread with the strong constraints x_ij <= y_i separated
# (-B InnerBCfg-MILP.txt), which the Lagrangian methods do not want. Such an
# instance also runs Benders' decomposition on its Benders form (ldld_bench
# -b -S BendersSCfg.txt): BDS, and on the network design instances, which
# have complete recourse, BDSLD too (BMETHODS, default "0" and "0 1", the
# indices of the Solver in config/BendersSCfg.txt).

set -u
out=${1:?usage: run-campaign <out-dir> [name ...]}
shift
here=$(cd "$(dirname "$0")" && pwd)
bench=${BENCH:-$here/build/ldld_bench}
methods=${METHODS:-0 1 2 3 4 5}
reps=${REPS:-1}
QUIET=${QUIET:-8}
timeout=${TIMEOUT:-5400}
jobs=${JOBS:-1}
names=(MILP LP LD LDLD LDrec MILP1)
recover=(0 0 1 1 1 0)
# the methods on the Benders form (ldld_bench -b, config/BendersSCfg.txt),
# run on the instances whose here-and-now decisions are integer designs
bnames=(BDS BDSLD)

load()  { cut -d' ' -f1 /proc/loadavg; }
quiet() {
  awk -v x="$(load)" -v q="$QUIET" 'BEGIN{exit !(x<q)}' || return 1
  # the pattern is matched against the others' command lines, this script
  # and the grep of this very test excluded, which carry it in theirs
  [ -z "${BUSY:-}" ] ||
    ! ps -eo args= | grep -v -e "run-campaign" -e "grep" |
      grep -Eq -- "$BUSY"
}
say()   { echo "[$(date +%m-%d_%H:%M)] $*"; }

[ -x "$bench" ] || { echo "run-campaign: no ldld_bench at $bench" >&2; exit 1; }
mkdir -p "$out/logs"
csv=$out/runs.csv

# the configuration the campaign runs with is copied next to its results,
# so that a result can always be traced to the files that produced it
[ -d "$out/config" ] || cp -r "$here/config" "$out/config"
[ -e "$out/machine.txt" ] || {
  uname -a; lscpu | grep -E 'Model name|^CPU\(s\)|Thread|Socket'
  free -g | head -2; date; } > "$out/machine.txt"

grep -v '^#' "$here/instances.txt" | grep -v '^ *$' |
while read -r name axis args; do
  if [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qx "$name"; then
    continue
  fi
  # a tree runs the recursive form on the MultiStageStochasticBlock and
  # every method on the TwoStageStochasticBlock of the same leaves
  case $name in
    ttr_*) runs="${name}:4 ${name}_2s:$(echo $methods | tr ' ' ,)" ;;
    cfl_*|mmcf_*)
      # BDSLD needs complete recourse, which only the network design
      # instances have
      case $name in
        mmcf_*) bmethods=${BMETHODS:-0 1} ;;
        *)      bmethods=${BMETHODS:-0} ;;
      esac
      runs="${name}:$(echo $methods | tr ' ' ,)"
      runs="$runs ${name}:$(echo $bmethods | sed 's/[0-9][0-9]*/b&/g' | tr ' ' ,)" ;;
    *)     runs="${name}:$(echo $methods | tr ' ' ,)" ;;
  esac
  for run in $runs; do
  inst=${run%%:*}
  file=$here/instances/smspp_$inst.nc4
  [ -e "$file" ] || { say "$inst: no instance, run make-instances"; continue; }
  for k in $(echo "${run#*:}" | tr , ' '); do
    # bN is the N-th method of the Benders form
    b=
    case $k in b*) b=1; k=${k#b} ;; esac
    if [ -n "$b" ]; then m=${bnames[$k]}; else m=${names[$k]}; fi
    for rep in $(seq 1 "$reps"); do
      # a run already there is skipped only if it is a measure, i.e., the
      # load at its end was below the threshold; one that was not is run
      # again, and plot_ldld.py leaves the old line out
      if [ -e "$csv" ] &&
         grep "^smspp_$inst,$m,.*,$rep,[^,]*,[^,]*\$" "$csv" |
         awk -F, -v q="$QUIET" '$NF < q { f = 1 } END { exit ! f }'
      then continue; fi
      until quiet; do sleep 120; done
      l0=$(load)
      opt=( -c "$out/config/" -k "$k" -m "$m"
            -l "$out/logs/$inst.$m.$rep.log" )
      case $inst,$m in
        cfl_*,MILP|cfl_*,LP|cfl_*,MILP1|mmcf_*,MILP|mmcf_*,LP|mmcf_*,MILP1)
          opt+=( -B InnerBCfg-MILP.txt ) ;;
      esac
      if [ -n "$b" ]; then opt+=( -b -S BendersSCfg.txt )
      elif [ "${recover[$k]}" = 1 ]; then
       opt+=( -R ScnBSCfg-IP.txt -j "$jobs" ); fi
      line=$(timeout "$timeout" "$bench" "${opt[@]}" "$file" 2>> "$out/errors" |
             tail -1)
      l1=$(load)
      [ -n "$line" ] || line="smspp_$inst,$m,timeout,,,$timeout,,"
      # the fields of the recovery are empty where there is none
      nf=$(echo "$line" | awk -F, '{print NF}')
      [ "$nf" -lt 11 ] && line="$line,,,"
      echo "$line,$rep,$l0,$l1" >> "$csv"
      say "$inst $m rep $rep: $(echo "$line" | cut -d, -f3-6) (load $l0 -> $l1)"
    done
  done
  done
done
