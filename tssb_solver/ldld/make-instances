#!/usr/bin/env bash
#
# make-instances [ name ... ]
#
# Builds in instances/ the Block files of the study listed in instances.txt
# (all of them, or those named), each by gen/gen_thermal_tssb.py and then
# gen/emit_thermal_tssb.py; a file already there is left alone. It needs a
# Python with pypsa and pypsa2smspp (PYTHON, default python3).

set -eu
here=$(cd "$(dirname "$0")" && pwd)
py=${PYTHON:-python3}
mkdir -p "$here/instances"

grep -v '^#' "$here/instances.txt" | grep -v '^ *$' |
while read -r name axis args; do
  if [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qx "$name"; then
    continue
  fi
  if [ -e "$here/instances/smspp_$name.nc4" ]; then
    echo "$name: already there"
    continue
  fi
  echo "$name: generating ($axis)"
  "$py" "$here/gen/gen_thermal_tssb.py" $args --name "$name"
  "$py" "$here/gen/emit_thermal_tssb.py" "$name"
done
