# ============================================================
#  tools/ — .gitignore
# ============================================================

# --- Project-specific ---------------------------------------
# Per-solver binaries
block_solver/block_solver
investmentblock_solver/investmentblock_solver
investmentblock_solver/investment_candidates.txt
sddp_solver/sddp_solver
ucblock_solver/ucblock_solver
tssb_solver/tssb_solver
chgcfg/chgcfg

# Generic run output
*.lp
log*.txt
LD*.txt

# SDDP solver run output (root only: the tracked instances are in examples/)
sddp_solver/*.gsbd
sddp_solver/*.gsbmf
sddp_solver/*.txt*
sddp_solver/*.btr
sddp_solver/*.nc4*
sddp_solver/sub-log-*

# --- C/C++ build artifacts ----------------------------------
*.o
*.obj
*.d
*.gch
*.pch
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.dSYM/
*.pdb
*.idb
*.ilk
*.map
*.exp
*.gcno
*.gcda

# --- CMake --------------------------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeLists.txt.user
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/

# --- IDEs ---------------------------------------------------
.idea/
.vscode/
*.iml
*.iws
out/
**/*.xcodeproj
**/*_XPRJ

# --- OS junk ------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*~
.directory
.fuse_hidden*
.nfs*
